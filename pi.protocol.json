{
  "protocolVersion": "0.2.0",
  "nodeId": "pi-search-extension",
  "packageId": "pi-search-extension",
  "version": "0.2.0",
  "purpose": "Minimal private-first web search, local content extraction, and local content cache for Pi agents.",
  "tags": ["pi", "search", "web", "minimal", "privacy"],
  "provides": [
    {
      "name": "web_search",
      "description": "Local-first web search. Ensures the bundled loopback SearXNG container is running, with optional Brave fallback. No Exa/Perplexity/OpenAI by default.",
      "tags": ["search", "web"],
      "effects": ["network"],
      "inputSchema": { "type": "object", "properties": { "query": { "type": "string", "minLength": 1 }, "queries": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1 } }, "max_results": { "type": "integer", "minimum": 1, "maximum": 20 }, "provider": { "type": "string", "enum": ["searxng", "brave"] } } },
      "outputSchema": { "type": "object" },
      "execution": { "type": "handler", "handler": "web_search" }
    },
    {
      "name": "fetch_content",
      "description": "Fetch and locally extract readable content from a URL or PDF. Jina fallback is opt-in only. Stores full result in local cache.",
      "tags": ["web", "extract", "cache"],
      "effects": ["network", "filesystem"],
      "inputSchema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "minLength": 1 }, "quality_threshold": { "type": "number", "minimum": 0, "maximum": 100 }, "force_jina": { "type": "boolean" }, "max_chars": { "type": "integer", "minimum": 1, "maximum": 50000 }, "refresh": { "type": "boolean" }, "cache_max_age_minutes": { "type": "number", "minimum": 0 } } },
      "outputSchema": { "type": "object" },
      "execution": { "type": "handler", "handler": "fetch_content" }
    },
    {
      "name": "get_cached_content",
      "description": "Retrieve locally cached content by id or URL with offset/length slicing.",
      "tags": ["cache", "content"],
      "effects": ["filesystem"],
      "inputSchema": { "type": "object", "properties": { "id": { "type": "string", "minLength": 1 }, "url": { "type": "string", "minLength": 1 }, "start": { "type": "integer", "minimum": 0 }, "max_chars": { "type": "integer", "minimum": 1, "maximum": 50000 } } },
      "outputSchema": { "type": "object" },
      "execution": { "type": "handler", "handler": "get_cached_content" }
    }
  ]
}
