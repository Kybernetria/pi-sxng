{
  "name": "pi-search-extension",
  "version": "0.3.0",
  "description": "Private-first SearXNG search and bounded content extraction through pi-protocol.",
  "type": "module",
  "main": "./extension.ts",
  "exports": {
    ".": "./extension.ts",
    "./protocol/handlers": "./protocol/handlers.ts",
    "./pi.protocol.json": "./pi.protocol.json",
    "./operations": "./src/operations.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "search",
    "minimal",
    "web",
    "pi-protocol"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "protocol:check": "pi-protocol check .",
    "protocol:generate": "pi-protocol generate ."
  },
  "piProtocol": {
    "generated": "protocol.generated.ts"
  },
  "dependencies": {
    "@kybernetria/pi-protocol": "https://github.com/Kybernetria/pi-protocol/releases/download/v3.0.3/kybernetria-pi-protocol-3.0.3.tgz",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.4",
    "undici": "^7.16.0",
    "unpdf": "^1.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^26.0.1",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0"
  },
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "files": [
    "index.ts",
    "extension.ts",
    "src",
    "protocol",
    "protocol.generated.ts",
    "pi.protocol.json",
    "README.md",
    "compose.yaml",
    "deploy"
  ]
}
